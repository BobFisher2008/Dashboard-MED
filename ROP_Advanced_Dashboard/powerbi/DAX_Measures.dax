-- Create a dedicated table named Measures, then add the following measures.

Total SKU :=
DISTINCTCOUNT ( DimSKU[SKU_ID] )

Inventory Rows :=
COUNTROWS ( FactInventorySnapshot )

Matched Inventory Rows :=
CALCULATE (
    [Inventory Rows],
    NOT ISBLANK ( FactInventorySnapshot[SKU_ID] )
)

Unmatched Inventory Rows :=
[Inventory Rows] - [Matched Inventory Rows]

Mapping Rate % :=
DIVIDE ( [Matched Inventory Rows], [Inventory Rows] )

Total On Hand :=
SUM ( FactSKUStatus[OnHand] )

Total On Order :=
SUM ( FactSKUStatus[OnOrder] )

Total Backorder :=
SUM ( FactSKUStatus[Backorder] )

Inventory Position :=
SUM ( FactSKUStatus[InventoryPosition] )

Total ROP :=
SUM ( FactSKUStatus[ROP] )

ROP Gap :=
SUM ( FactSKUStatus[ROPGap] )

Weighted ROP Gap :=
SUM ( FactSKUStatus[WeightedGap] )

Coverage % :=
DIVIDE ( [Inventory Position], [Total ROP] )

Stockout SKU :=
CALCULATE (
    DISTINCTCOUNT ( FactSKUStatus[SKU_ID] ),
    FactSKUStatus[Status] = "Тасарсан"
)

Below ROP SKU :=
CALCULATE (
    DISTINCTCOUNT ( FactSKUStatus[SKU_ID] ),
    FactSKUStatus[Status] = "ROP-оос доош"
)

Normal SKU :=
CALCULATE (
    DISTINCTCOUNT ( FactSKUStatus[SKU_ID] ),
    FactSKUStatus[Status] = "Хэвийн"
)

Excess SKU :=
CALCULATE (
    DISTINCTCOUNT ( FactSKUStatus[SKU_ID] ),
    FactSKUStatus[Status] = "Илүүдэл"
)

Missing Inventory SKU :=
CALCULATE (
    DISTINCTCOUNT ( FactSKUStatus[SKU_ID] ),
    FactSKUStatus[Status] = "Өгөгдөл алга"
)

Missing ROP SKU :=
CALCULATE (
    DISTINCTCOUNT ( DimSKU[SKU_ID] ),
    DimSKU[HasROP] = FALSE ()
)

Critical V/E SKU :=
CALCULATE (
    DISTINCTCOUNT ( FactSKUStatus[SKU_ID] ),
    FactSKUStatus[IsCritical] = TRUE ()
)

Vital Risk SKU :=
CALCULATE (
    DISTINCTCOUNT ( FactSKUStatus[SKU_ID] ),
    DimSKU[VED] = "V",
    FactSKUStatus[Status] IN { "Тасарсан", "ROP-оос доош" }
)

Essential Risk SKU :=
CALCULATE (
    DISTINCTCOUNT ( FactSKUStatus[SKU_ID] ),
    DimSKU[VED] = "E",
    FactSKUStatus[Status] IN { "Тасарсан", "ROP-оос доош" }
)

Excess Quantity :=
SUMX (
    FILTER ( FactSKUStatus, FactSKUStatus[Status] = "Илүүдэл" ),
    MAX ( FactSKUStatus[InventoryPosition] - FactSKUStatus[ROP], 0 )
)

High Confidence ROP SKU :=
CALCULATE (
    DISTINCTCOUNT ( DimSKU[SKU_ID] ),
    DimSKU[ROP_Confidence] = "Өндөр"
)

Low Confidence ROP SKU :=
CALCULATE (
    DISTINCTCOUNT ( DimSKU[SKU_ID] ),
    DimSKU[ROP_Confidence] = "Бага"
)

High Confidence ROP % :=
DIVIDE ( [High Confidence ROP SKU], [Total SKU] )

Branch ROP Exposure :=
SUM ( FactBranchROP[ROP] )

Branch V ROP :=
CALCULATE ( [Branch ROP Exposure], DimSKU[VED] = "V" )

Branch E ROP :=
CALCULATE ( [Branch ROP Exposure], DimSKU[VED] = "E" )

Branch D ROP :=
CALCULATE ( [Branch ROP Exposure], DimSKU[VED] = "D" )

Active Branch SKU :=
CALCULATE (
    DISTINCTCOUNT ( FactBranchROP[SKU_ID] ),
    FactBranchROP[ROP] > 0
)

Latest Snapshot Date :=
MAX ( FactSKUStatus[SnapshotDate] )

Risk Rate % :=
DIVIDE ( [Stockout SKU] + [Below ROP SKU], [Total SKU] )

ROP Gap per Active SKU :=
DIVIDE ( [ROP Gap], [Stockout SKU] + [Below ROP SKU] )

-- Optional traffic-light measure for KPI conditional formatting.
Coverage Color :=
SWITCH (
    TRUE (),
    [Coverage %] < 0.80, "#B91C1C",
    [Coverage %] < 1.00, "#F97316",
    [Coverage %] <= 2.00, "#0F766E",
    "#2563EB"
)
